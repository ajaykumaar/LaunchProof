# Public demo target ("Brightboard"), so Fly load generators and Stripe can reach it.
# See RUNBOOK.md step 4. Keep ONE small machine: state is in memory and the point is that it breaks.
FROM python:3.12-slim
RUN pip install --no-cache-dir "fastapi>=0.115" "uvicorn>=0.30" python-multipart stripe
WORKDIR /app
COPY demo_shop demo_shop
EXPOSE 8080
# --proxy-headers so Stripe success_url is built with https behind Fly's proxy
CMD ["uvicorn", "demo_shop.app:app", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers", "--forwarded-allow-ips", "*"]
