# Optional: web app that also runs checks locally (needs Chromium). Prefer Dockerfile.api + Brainbase.
FROM mcr.microsoft.com/playwright/python:v1.56.0-noble
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY launchproof launchproof
COPY api api
COPY legal legal
ENV LP_RUNS_DIR=/app/runs
EXPOSE 8080
CMD ["uvicorn", "api.server:app", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers", "--forwarded-allow-ips", "*"]
