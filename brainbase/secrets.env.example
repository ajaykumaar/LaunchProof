# Copy to brainbase/agents/<slug>/.brainbase/secrets.env for `brainbase agent push`, or add in the UI (Secrets).
# Put shared secrets on the orchestration once; members inherit them.
#
# Required for all agents:
GITHUB_TOKEN=github_pat_...
LP_REPO=github.com/YOUR_GITHUB_USER/launchproof.git
LP_SECRET=change-me-long-random
#
# Optional — multi-region Fly (leave unset until card/billing works; load then runs in sandbox/local):
# FLY_API_TOKEN=FlyV1 ...
# FLY_APP=launchproof-load-YOU
# LP_REGIONS=sjc iad
# LP_USE_FLY=1
# LP_RESULT_BASE=https://launchproof-api-YOU.fly.dev
# LP_RESULT_TOKEN=long-random
# LP_LOAD_IMAGE=registry.fly.io/launchproof-load-YOU:engine
#
# Synthetic signup emails + notifications (Triage falls back to these if Slack/Linear OAuth not connected):
LP_TEST_EMAIL_DOMAIN=example.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
LINEAR_API_KEY=lin_api_...
LINEAR_TEAM_ID=...
#
# Optional: ANTHROPIC_API_KEY lets the CLI's own Claude loop / template rewrite run inside the sandbox.
# Not needed when the Brainbase agent records the journey via MCP tools and writes fix prompts itself.
#
# Optional Smart UI budget defaults (Chaos + Critic on Brainbase; no Anthropic vision):
# LP_SMART_UI_BUDGET={"max_chaos_scenarios":3,"max_vision_views":4,"max_pages_hint":5,"credit_soft_cap":40}
# LP_MAX_CHAOS=3
# LP_MAX_VISION_VIEWS=4
# LP_SMART_UI_CREDITS=40
#
# For the thin web app (when deployed), also set:
# BRAINBASE_API_KEY=...
# BRAINBASE_AGENT_ID=<tester agent id>
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PUBLIC_URL=https://your-public-api-host
